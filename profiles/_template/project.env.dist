# profiles/_template/project.env.dist — ШАБЛОН профиля проекта.
# Копируй: cp profiles/_template/project.env.dist profiles/<project>/project.env
# Рабочие значения держим локально (project.env в .gitignore), чтобы в публичном
# ядре не было ни путей, ни репозиториев, ни дедлайнов, ни имён проекта и команды.
# Формат: KEY=VALUE, один ключ на строку. Читают setup.sh и toolkit-скрипты.
#
# Модель: АГЕНТ (каталог-клон, код, свой стек) принадлежит ДОРОЖКЕ (lane) — пулу
# одной компетенции с ёмкостью. Ёмкость и маршрутизация считаются по дорожкам,
# скиллы назначаются дорожке, стек (docker/порты) — агенту.

# --- Идентификация ---------------------------------------------------------
PROJECT=                # короткое кодовое имя (латиница, без пробелов, напр. myproject)
PROJECT_TITLE=          # человекочитаемое имя (для подписей; можно пусто)
PROJECT_KIND=web        # web | mobile — состав контейнеров и команды тестов

# --- Расположение клонов ---------------------------------------------------
AGENTS_ROOT=            # напр. /path/to/<project>/projects
AGENT_PREFIX=           # префикс каталогов клонов, напр. myproject-

# --- Состав команды: каталог:код:дорожка (порядок = порядок в конвейере) ----
# Обязательный минимум: РП + один разработчик + тестер + DevOps.
# Остальные роли добавляются строкой (лид, аналитик, второй дев, безопасник, юрист…).
AGENTS="<prefix>pm-jan:jan:pm <prefix>lead-apr:apr:lead <prefix>dev-may:may:dev <prefix>tester-mar:mar:test <prefix>devops-jul:jul:devops"

# --- Дорожки: имя:ёмкость на одного агента:название -------------------------
# Ёмкость дорожки = ёмкость × число её агентов. Двое девов на одном стеке → одна
# дорожка (dev:14). Разные платформы/стеки → разные дорожки (backend:14, mobile:14):
# задачи не взаимозаменяемы, маршрутизация идёт по дорожкам.
LANES="dev:14:разработка lead:18:лид analytics:18:аналитика test:18:тестирование devops:18:DevOps pm:18:РП"

# --- Подписи агентов и стем стека ------------------------------------------
# AGENT_STEM_<КОД> задаёт docker-проект (DOCKER_PREFIX_<стем>) и префикс портов
# (PORT_<СТЕМ>_APP|DB|WEB). По умолчанию стем = код агента.
AGENT_TITLE_JAN="<Имя> (РП)"
AGENT_SHORT_JAN="<Имя>"
AGENT_DOES_JAN="план, статусы, статьи, дашборд, коммуникация с руководителем"
AGENT_STEM_JAN=pm
AGENT_TITLE_MAY="<Имя> (dev)"
AGENT_SHORT_MAY="<Имя>"
AGENT_DOES_MAY="реализация фич, тесты, рефакторинг"
AGENT_STEM_MAY=may

# --- Наборы скиллов (необязательно) ----------------------------------------
# Дефолты по дорожкам лежат в ядре (setup.sh: CORE_LANE_SKILLS). Переопределение:
# LANE_SKILLS_<ДОРОЖКА>="…"  — для всей дорожки (ОБЯЗАТЕЛЬНО для НОВОЙ дорожки: иначе
#                              агенты получат только глобальные скиллы);
# AGENT_SKILLS_<КОД>="…"     — для одного агента (сильнее дорожки).
# Пример: мобильному разработчику explain-db не нужен:
# AGENT_SKILLS_JUN="run-tests write-aquarium find-dead-code"
# Пример новой дорожки: LANE_SKILLS_BACKEND="run-tests explain-db write-aquarium find-dead-code"

# --- Группы дорожек и подмены (необязательно; использует toolkit, шаг 5) -----
# LANE_GROUP_DEV="backend,mobile"      # сводка «разработка» по нескольким дорожкам
# LANE_FALLBACK_ANALYTICS="lead"       # если дорожки нет в составе — кто берёт её задачи
# LANE_FALLBACK_LEAD="pm"

# --- Переопределения контента из профиля (необязательно) -------------------
# Скилл:     profiles/<project>/skills/<скилл>.<код>.md  (или .<дорожка>.md, или .md)
# Карточка:  profiles/<project>/roles/<код>.md
# Пример: мобильному разработчику нужен свой run-tests и своя карточка.

# --- Словарь «кто держит мяч» (поле awaiting в статьях) --------------------
# Формат: значение:тип[:привязка]. Типы: owner (руководитель) | lane (дорожка — мяч у любого её
# агента) | agent (конкретный агент) | none (мяч не привязан, значение «—»). Значения — только из
# списка: toolkit валидирует awaiting по нему, а дашборд группирует блоки «Ждёт меня / Ждут агентов»
# по типу. Роли и имена агентов объявляются наравне — в статьях допустимы оба варианта.
AWAITING="<Имя руководителя>:owner РП:lane:pm Аналитик:lane:analytics Лид:lane:lead Дев:lane:dev Тест:lane:test DevOps:lane:devops —:none"
# Шаблон заготовки задачи (templates/task_stub.md) — подстановки для plan_apply.py
STUB_TZ_FUNC=          # разделы ТЗ для функциональных задач (напр. 2.1, 3.1)
STUB_TZ_PLAN=          # разделы ТЗ для служебных doc/infra/planning
STUB_VERIFICATION=     # строка «Верификация» в заготовке (тесты/e2e проекта)


# --- Репозитории -----------------------------------------------------------
# В правилах/скиллах фигурирует ИМЯ репозитория (CODE_REPO/DOCS_REPO), URL — для клонирования.
CODE_REPO=              # имя репо кода, напр. myproject | myproject-api
CODE_REPO_URL=          # git@github.com:<org>/<project>.git
# Второй репозиторий кода (если проект разделён, напр. api + app). Пусто — один репо.
APP_REPO=              # имя второго репо, напр. <project>-app
APP_REPO_URL=          # git@github.com:<org>/<project>-app.git

CODE_BRANCH=develop
DOCS_REPO=              # имя репо доков, напр. myproject-docs
DOCS_REPO_URL=          # git@github.com:<org>/<project>-docs.git
DOCS_BRANCH=main
PM_DIR=                 # каталог клона РП (в нём Обсидиан-клон доков)

# --- Docker ----------------------------------------------------------------
DOCKER_PREFIX=          # префикс compose-проектов, напр. myproject
DOCKER_PM=              # свой стек РП (агентский)
DOCKER_DEV=             # dev-стенд (общий для команды)
DOCKER_PROD=            # стенд приёмки руководителя
PROD_DATA_DIR=          # локальная папка стенд-БД (docker-compose.yml без репозитория)

# --- Порты (уникальны в пределах машины!) ----------------------------------
# Для kind=web: APP (nginx) / DB (PostgreSQL) / WEB (Vite). Для kind=mobile WEB не нужен.
# Агент без стека (юрист, безопасник) — ключи не заводим, карточку кладём в профиль.
PORT_PM_APP=
PORT_PM_DB=
PORT_PM_WEB=
PORT_LEAD_APP=
PORT_LEAD_DB=
PORT_LEAD_WEB=
PORT_MAY_APP=
PORT_MAY_DB=
PORT_MAY_WEB=
PORT_TESTER_APP=
PORT_TESTER_DB=
PORT_TESTER_WEB=
PORT_DEVOPS_APP=
PORT_DEVOPS_DB=
PORT_DEVOPS_WEB=
PORT_DEV_APP=
PORT_DEV_DB=
PORT_DEV_WEB=
PORT_PROD_APP=
PORT_PROD_DB=

# --- План: спринты, этапы, дедлайны ---------------------------------------
CUR_SPRINT=             # текущий спринт (для Канбана и дашборда)
SPRINT_FROM=            # с какого спринта показывать планировщик
SPRINT_TO=              # по какой (включительно)
STAGES="Альфа,Бета,Промпилот,Поддержка"
DEADLINE_D1=            # Д1 (ГГГГ-ММ-ДД) или пусто
DEADLINE_D2=            # Д2 (ГГГГ-ММ-ДД) или пусто

# --- Ёмкость дорожек (чел-дни на спринт) ----------------------------------
SPRINT_DAYS=            # рабочих дней в спринте (21 календарный = 18 при графике Ср–Пн)
CAP_DEV=                # на одного дева (ёмкость dev-дорожки = число девов × CAP_DEV)
CAP_LEAD=
CAP_ANALYTICS=
CAP_TEST=
CAP_DEVOPS=
CAP_PM=
