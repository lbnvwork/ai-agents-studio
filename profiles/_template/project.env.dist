# profiles/_template/project.env.dist — ШАБЛОН профиля проекта (копируй в profiles/<project>/project.env)
# Рабочие значения держим локально в project.env (он в .gitignore), чтобы
# в публичном ядре не было ни рабочих путей, ни репозиториев, ни дедлайнов проекта.
#
# Как включить профиль:  ./setup.sh --project <name>
# Файл читается setup.sh и toolkit-скриптами как KEY=VALUE.

# --- Идентификация ---------------------------------------------------------
PROJECT=                # короткое кодовое имя (латиница, без пробелов, напр. myproject)
PROJECT_TITLE=          # человекочитаемое имя (для README/подписей; можно пусто)
PROJECT_KIND=web        # web | mobile — влияет на состав контейнеров и команды тестов

# --- Где живут клоны агентов ----------------------------------------------
AGENTS_ROOT=            # напр. /path/to/<project>/projects
AGENT_PREFIX=           # префикс каталогов клонов, напр. myproject-
# Каталог агента : роль. Порядок = порядок в конвейере (РП → аналитик → лид → dev → тест → DevOps)
AGENTS="<prefix>pm-jan:jan <prefix>analyst-feb:feb <prefix>lead-apr:apr <prefix>dev-may:may <prefix>dev-jun:jun <prefix>tester-mar:mar <prefix>devops-jul:jul"

# --- Репозитории -----------------------------------------------------------
# В правилах/скиллах фигурирует ИМЯ репозитория (CODE_REPO/DOCS_REPO), а URL — для клонирования.
CODE_REPO=              # имя репо кода, напр. myproject | myproject-api
CODE_REPO_URL=          # git@github.com:<org>/<project>.git
CODE_BRANCH=develop
DOCS_REPO=              # имя репо доков, напр. myproject-docs
DOCS_REPO_URL=          # git@github.com:<org>/<project>-docs.git
DOCS_BRANCH=main
PM_DIR=                 # каталог клона РП (в нём Обсидиан-клон доков)

# --- Docker ----------------------------------------------------------------
# Агентские стеки называются <DOCKER_PREFIX>_<стем>, где стем — pm | feb | lead | may | jun | tester | jul
# (соответствие роль → стем: setup.sh, функция role_stem). Порты агента — PORT_<СТЕМ>_*.
DOCKER_PREFIX=          # префикс compose-проектов, напр. myproject
DOCKER_PM=              # свой стек РП (агентский)
DOCKER_DEV=             # dev-стенд (общий для команды)
DOCKER_PROD=            # стенд приёмки руководителя
PROD_DATA_DIR=          # локальная папка стенд-БД (docker-compose.yml без репозитория)

# --- Порты (уникальны в пределах машины!) ----------------------------------
# Для kind=web: APP (nginx) / DB (PostgreSQL) / WEB (Vite). Для kind=mobile: WEB не используется.
PORT_MAY_APP=
PORT_MAY_DB=
PORT_MAY_WEB=
PORT_JUN_APP=
PORT_JUN_DB=
PORT_JUN_WEB=
PORT_JUL_APP=
PORT_JUL_DB=
PORT_JUL_WEB=
PORT_LEAD_APP=
PORT_LEAD_DB=
PORT_LEAD_WEB=
PORT_TESTER_APP=
PORT_TESTER_DB=
PORT_TESTER_WEB=
PORT_PM_APP=
PORT_PM_DB=
PORT_PM_WEB=
PORT_FEB_APP=
PORT_FEB_DB=
PORT_FEB_WEB=
PORT_DEV_APP=
PORT_DEV_DB=
PORT_DEV_WEB=
PORT_PROD_APP=
PORT_PROD_DB=

# --- План: спринты, этапы, дедлайны ---------------------------------------
CUR_SPRINT=             # текущий спринт (для Канбана и дашборда)
SPRINT_FROM=            # с какого спринта показывать планировщик
SPRINT_TO=              # по какой (включительно)
STAGES="Альфа,Бета,Промпилот,Поддержка"
DEADLINE_D1=            # Д1 (ГГГГ-ММ-ДД) или пусто
DEADLINE_D2=            # Д2 (ГГГГ-ММ-ДД) или пусто

# --- Ёмкость дорожек (чел-дни на спринт) ----------------------------------
SPRINT_DAYS=            # рабочих дней в спринте (21 календарный = 18 при графике Ср–Пн)
CAP_DEV=                # на одного дева (ёмкость dev-дорожки = 2 × CAP_DEV)
CAP_LEAD=
CAP_ANALYTICS=
CAP_TEST=
CAP_DEVOPS=
CAP_PM=
